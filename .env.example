# --- Kamera / Stream Konfigurasi ---
# Main stream biasanya kualitas tinggi (1080p/4K)
RTSP_URL_MAIN=rtsp://admin:bismillah123@192.168.77.209:554/cam/realmonitor?channel=1&subtype=0
# Substream biasanya kualitas rendah (VGA/D1) cocok untuk analitik ringan / deteksi agar tidak memberatkan CPU
RTSP_URL_SUBSTREAM=rtsp://admin:bismillah123@192.168.77.209:554/cam/realmonitor?channel=1&subtype=1

# --- Supabase Konfigurasi ---
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=attendance-snapshots

# --- API & Security Konfigurasi ---
BACKEND_API_URL=http://localhost:3000/api/recognition/thumbnail
ML_API_KEY=your-secret-api-key-to-auth-requests

# --- Lokal Storage Konfigurasi ---
# Path tempat data wajah karyawan yang sudah di-enroll/disimpan
ENROLL_DATA_PATH=./data/enrolled
# Path tempat menyimpan snapshot wajah yang tidak dikenal atau sebelum dikirim
TEMP_SNAPSHOT_PATH=./data/snapshots

# --- Recognition Service Konfigurasi ---
DETECTION_STREAM_URL=http://192.168.43.11:8000/api/v1/faces/stream
DATABASE_URL=postgresql://user:password@localhost:5432/attendance_db
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
