# Copy to .env.pi; never commit credentials. Environment overrides this file.
PI_RTSP_URL=rtsp://192.168.77.100:8554/cam01
PI_CAMERA_ID=cam01
PI_STREAM_PATH=cam01
# Local Redis is a safe bootstrap default, NOT the production server address.
# Set this to the Redis endpoint consumed by the server API and recognition.
PI_REDIS_URL=tcp://127.0.0.1:6379
PI_FACE_CHANNEL=face_preprocessed_queue
PI_BBOX_CHANNEL=face_detection_queue
PI_MODEL_PATH=models/scrfd_2.5g_kps.onnx
# 500 ms rest after inference; actual FPS is lower than this ceiling.
PI_INFERENCE_FPS=2
PI_INFERENCE_THREADS=1
PI_IO_TIMEOUT_MS=3000
PI_MAX_FRAME_AGE_MS=2000
PI_JPEG_QUALITY=90
